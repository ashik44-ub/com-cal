# Copy this file to .env.local and fill in your own values:
#   cp .env.local.example .env.local
# Never share .env.local — it holds your database password.

# MongoDB connection string (MongoDB Atlas).
# Paste your own Atlas connection string here. Your cluster name and
# database user/password go in that string, not in this file.
# Example format (do NOT use this line as-is):
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The app always uses the database "commission-calculator" (collection "bills"),
# even if the connection string has no database name in it.
# Leave it empty to run on temporary in-memory storage.
MONGODB_URI=

# Login for the app. Change these to your own username and password.
# If they are left empty, the defaults are used:
#   username: ashikur
#   password: commission123
APP_USERNAME=ashikur
APP_PASSWORD=commission123

# Secret used to sign the session cookies. If it is not set, APP_PASSWORD
# is used instead. Change it (and restart) to log everyone out.
# SESSION_SECRET=change-this-to-a-long-random-string
